# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local bulk dataset downloads (TalkingCelebs, VoxMini, etc.) -- never commit raw video
.data/

# Hydra run dirs (hydra.job.chdir=false, so these are logs only, never inputs)
outputs/

# Live mesh/watcher state and experiment results (runs/state, runs/results).
# Gitignored because state churns every watcher tick, not because it's
# disposable -- it's backed up via sync_login-node.sh's pull-before-push rsync.
# Deliberately NOT under .claude/: that dir is Claude Code tooling state and
# a stray `rm -rf .claude` must never take production data with it.
runs/

# Temporary files
*.tmp
.pytest_cache/
.ruff_cache/
.superpowers/
graphify-out/

# IDEs
.vscode/
.claude/
CLAUDE.md
.claudeignore

# Worktrees (superpowers:using-git-worktrees)
.worktrees/